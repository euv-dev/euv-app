# Tauri regenerates src/main/**/generated on every `tauri android build`,
# so its contents stay ignored — EXCEPT the two files that carry euv-app's
# local customizations (the custom-protocol cache interceptor in
# RustWebViewClient.kt and the matching RustWebView.kt). Those two are
# committed so a fresh clone reproduces the same APK; build.sh backs them
# up before the Tauri build and restores them afterwards.
/src/main/**/generated/*
!/src/main/**/generated/RustWebViewClient.kt
!/src/main/**/generated/RustWebView.kt
/src/main/jniLibs/**/*.so
/src/main/assets/tauri.conf.json
/tauri.build.gradle.kts
/tauri.properties
/proguard-tauri.pro
